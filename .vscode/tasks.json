{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "docker: compose up.gradio@gpu-offline",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/docker/up.gradio@gpu-offline/"
            },
            "command": "docker compose -p marker up"
        },
        {
            "label": "docker: compose up@cpu-online",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/docker/up@cpu-online/"
            },
            "command": "docker compose -p marker up"
        },
        {
            "label": "docker: build master",
            "type": "shell",
            "command": "docker build -t xiaoyao9184/marker:master -f ./docker/build@source/dockerfile ."
        },
        {
            "label": "docker: build 2.0.0",
            "type": "shell",
            "command": "docker build -t xiaoyao9184/marker:2.0.0 -f ./docker/build@pypi/dockerfile ."
        },

        {
            "label": "hf: download models",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    // "HF_ENDPOINT": "https://hf-mirror.com",
                    // "HF_HUB_ETAG_TIMEOUT": "1000",
                    // "HF_HUB_DOWNLOAD_TIMEOUT": "1000"
                }
            },
            "command": [
                "hf download datalab-to/surya-ocr-2 --repo-type model --revision 3b3d4cd --cache-dir ./cache/huggingface/hub",
                "&& hf download datalab-to/surya-ocr-2-gguf --repo-type model --revision 6a3a4c3 --cache-dir ./cache/huggingface/hub",
                "&& hf download datalab-to/surya_layout2 --repo-type model --revision 0aee81d --local-dir ./cache/datalab/models/surya_layout2/0aee81d",
                "&& hf download xiaoyao9184/surya_text_detection --repo-type model --revision 2025_05_07 --local-dir ./cache/datalab/models/text_detection/2025_05_07",
                "&& hf download xiaoyao9184/surya_ocr_error_detection --repo-type model --revision 2025_02_18 --local-dir ./cache/datalab/models/ocr_error_detection/2025_02_18"
            ]
        },
        {
            "label": "conda: gradio gradio_app",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/",
                "env": {
                    // "HF_ENDPOINT": "https://hf-mirror.com",
                    // "HF_HUB_ETAG_TIMEOUT": "1000",
                    // "HF_HUB_DOWNLOAD_TIMEOUT": "1000",
                    "XDG_CACHE_HOME": "${workspaceFolder}/cache"
                }
            },
            "command": [
                "conda run --no-capture-output -n marker gradio gradio/gradio_app.py"
            ],
            "problemMatcher": []
        },
        {
            "label": "conda: run marker_gui",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/marker",
                "env": {
                    // "HF_ENDPOINT": "https://hf-mirror.com",
                    // "HF_HUB_ETAG_TIMEOUT": "1000",
                    // "HF_HUB_DOWNLOAD_TIMEOUT": "1000",
                    "STREAMLIT_SERVER_PORT": "8501",
                    "XDG_CACHE_HOME": "${workspaceFolder}/cache"
                }
            },
            "command": [
                "conda run --no-capture-output -n marker poetry run marker_gui"
            ],
            "problemMatcher": []
        },

        {
            "label": "conda: create env",
            "type": "shell",
            "command": [
                "conda env create -f ./environment.yml",
                "&& conda run --no-capture-output -n marker pip install -r requirements.override.txt",
            ]
        }
    ]
}